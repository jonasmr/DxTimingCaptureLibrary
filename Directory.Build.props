<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone build settings for DxTimingCaptureLibrary, extracted from the PIX tree.

  This file is the only thing that differs between a standalone build and an
  in-tree PIX build; the .vcxproj files reference the variables defined here and
  are otherwise unchanged. Per-project behaviour keys off properties the projects
  declare: ConfigurationType, TestCode, and UseStubPixEventDecoder.

  Headers shared with PIX are included unprefixed (<d3d12.h>, <D3D12Events.h>,
  <lddmcoreeventdefs.h>, <dstorage_etw.h>) so that each build can satisfy them
  from a different place. Here they come from the Agility SDK NuGet package and
  the vendored copies under third_party; PIX's equivalent props points the same
  includes at its own external\d3d and external\DirectStorage.

  A standalone build needs no PIX checkout: everything else resolves from the
  Windows SDK, NuGet, or third_party.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Supplies d3d12.h and friends. The package's own .targets prepends its
       include directory, so the Agility headers win over the Windows SDK's.
       A preview package is required: the D3D12_MARKER_API_* enum the marker
       decoder switches on only appears from the 719 preview onwards, and 721
       matches the D3D12_PREVIEW_SDK_VERSION of the header PIX vendors. -->
  <ItemGroup Condition="'$(DxTimingCaptureStandaloneBuild)' == 'true'">
    <PackageReference Include="Microsoft.Direct3D.D3D12" Version="1.721.1-preview" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <DxTimingCaptureStandaloneBuild Condition="'$(DxTimingCaptureStandaloneBuild)' == ''">true</DxTimingCaptureStandaloneBuild>
  </PropertyGroup>

  <PropertyGroup>
    <DxTimingCaptureLibraryRoot>$(MSBuildThisFileDirectory.TrimEnd('\'))</DxTimingCaptureLibraryRoot>
    <GoogleTestPath>$(DxTimingCaptureLibraryRoot)\third_party\googletest</GoogleTestPath>
    <PixEventDecoderPath>$(DxTimingCaptureLibraryRoot)\third_party\PixEventDecoder</PixEventDecoderPath>
    <PerfettoPath>$(DxTimingCaptureLibraryRoot)\third_party\perfetto</PerfettoPath>
    <ImguiPath>$(DxTimingCaptureLibraryRoot)\third_party\imgui</ImguiPath>
    <!-- Vendored DirectX ETW manifest headers (D3D12Events.h, lddmcoreeventdefs.h)
         and the DirectStorage ETW header, none of which ship in a public SDK or
         NuGet package. In a PIX build these directories are not on the include
         path and the in-tree copies are used. -->
    <EtwManifestPath>$(DxTimingCaptureLibraryRoot)\third_party\etw-manifest</EtwManifestPath>
    <DirectStorageEtwPath>$(DxTimingCaptureLibraryRoot)\third_party\directstorage</DirectStorageEtwPath>
    <!-- true: compile the DecodeTimingBlock stub and skip the decoder reference.
         false: link the real PixEventDecoder.lib (e.g. an in-tree PIX build). -->
    <UseStubPixEventDecoder Condition="'$(UseStubPixEventDecoder)' == ''">true</UseStubPixEventDecoder>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        $(DxTimingCaptureLibraryRoot)\include;
        $(EtwManifestPath);
        $(DirectStorageEtwPath);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'Application'">
    <Link>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;onecore.lib;uuid.lib;tdh.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>
