<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{4cc2e643-97df-4f7d-9740-93fccf974c7f}</ProjectGuid>
    <ConfigurationType>Application</ConfigurationType>
    <RootNamespace>WinPix</RootNamespace>
    <TargetName>DxEtwLibrary.test.functional</TargetName>
    <TestCode>true</TestCode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>
        $(GoogleTestPath)\googletest\include;
        $(PixEventDecoderPath)\include;
        $(PerfettoPath)\sdk;
        $(DxEtwLibraryRoot)\samples\perfetto;
        %(AdditionalIncludeDirectories);
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>
        %(AdditionalDependencies);
        d3d12.lib;
        dxgi.lib;
        d3dcompiler.lib;
        onecore.lib;
        dloadhelper.lib;
        uuid.lib;
        legacy_stdio_definitions.lib;
        legacy_stdio_wide_specifiers.lib;
        imagehlp.lib;
        ws2_32.lib;
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="EtwSession.cpp" />
    <ClCompile Include="main.cpp" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="D3D12ObjectTests.cpp" />
    <ClCompile Include="DirectStorageTests.cpp" />
    <ClCompile Include="JournalEntryTests.cpp" />
    <ClCompile Include="CommandListNameTests.cpp" />
    <ClCompile Include="GpuEngineActivityTests.cpp" />
    <ClCompile Include="GpuWorkload.cpp" />
    <ClCompile Include="PerfettoSampleTests.cpp" />
    <!-- The perfetto sample's writer is tested in place rather than duplicated. It
         and the trace reader are the only TUs that include perfetto.h, which is
         large and not written for /permissive-. -->
    <ClCompile Include="$(DxEtwLibraryRoot)\samples\perfetto\PerfettoTraceWriter.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ConformanceMode>false</ConformanceMode>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="PerfettoTraceReader.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ConformanceMode>false</ConformanceMode>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="EtwSession.h" />
    <ClInclude Include="GpuWorkload.h" />
    <ClInclude Include="PerfettoTraceReader.h" />
    <ClInclude Include="RecordingApiObjectCallbacks.h" />
    <ClInclude Include="RecordingDirectStorageCallbacks.h" />
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- In a UsePixUtility build, EtwException.h resolves to PIX's
         WinPix::ToolException (see DxEtwLibrary/EtwException.h), whose out-of-line
         symbols live in PixUtility.lib. A standalone build of the library uses the
         self-contained EtwException and does not need this reference. -->
    <ProjectReference Condition="'$(UsePixUtility)' == 'true'" Include="$(PixUtilityRoot)\lib\PixUtility.vcxproj">
      <Project>{6591c7c3-cf78-4150-992d-5e0c0d13e609}</Project>
    </ProjectReference>
    <ProjectReference Include="$(GoogleTestPath)\googletest_main.vcxproj">
      <Project>{14629fee-0926-4914-b534-87cd33cbc8ca}</Project>
    </ProjectReference>
    <ProjectReference Condition="'$(UseStubPixEventDecoder)' != 'true'" Include="$(PixEventDecoderPath)\lib\PixEventDecoder.lib.vcxproj">
      <Project>{750cf23a-1b4a-4f62-acb7-45fe8b78a7a7}</Project>
    </ProjectReference>
    <ProjectReference Include="$(DxEtwLibraryRoot)\lib\DxEtwLibrary.lib.vcxproj">
      <Project>{bd5d2df6-a412-48d8-a0c9-d220dccb92d3}</Project>
    </ProjectReference>
    <ProjectReference Include="$(PerfettoPath)\perfetto.vcxproj">
      <Project>{c7e5a2f0-8b3d-4e6a-9f12-3c4d5e6f7a80}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ItemGroup Condition="'$(DxEtwStandaloneBuild)' == 'true'">
    <PackageReference Include="Microsoft.Direct3D.DirectStorage" Version="1.3.0" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DxEtwStandaloneBuild)' == 'true' and '$(DirectStorageSdk)' == ''">
    <DirectStorageSdk>$(PkgMicrosoft_Direct3D_DirectStorage)</DirectStorageSdk>
  </PropertyGroup>
  <Import Project="$(DirectStorageSdk)\build\native\targets\Microsoft.Direct3D.DirectStorage.targets" Condition="Exists('$(DirectStorageSdk)\build\native\targets\Microsoft.Direct3D.DirectStorage.targets')" />
</Project>
